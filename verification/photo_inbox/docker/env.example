# Copy to .env beside compose.yaml. Paths are on the Homelab host. Never commit the .env.

# private data folder, outside every Git checkout (the SMB share snoredex-inbox points here)
INBOX_DATA=/srv/snoredex/inbox
# clones of github.com/m4s-ai/snoredex-data and github.com/m4s-ai/snoredex-photos (branch main)
SNOREDEX_DATA=/srv/snoredex/snoredex-data
SNOREDEX_PHOTOS=/srv/snoredex/snoredex-photos

# owner of those folders on the host (id -u, id -g)
PUID=1000
PGID=1000
INBOX_PORT=8765
SYNC_SECONDS=600

# posting (#646): the uploader's base URL and its API key; leave UPLOADER_URL empty to post nothing
UPLOADER_URL=
UPLOADER_KEY=
