{
  "meta": {
    "description": "Curated finish, foil-pattern, marking, size, and Cardmarket-product mappings that cannot be represented by TCGdex's group-level normal/holo/reverse flags.",
    "lastUpdated": "2026-07-23",
    "policy": [
      "A physical stamp is recorded in markings; the way a card was distributed is recorded separately in distribution.",
      "EX-era set-logo stamps that are intrinsic to the reverse-holo design use role=reverse-holo-treatment.",
      "Prerelease, Staff, retailer, Pokemon Center, and similar later stamps use role=distribution-promo and do not imply reverse holo.",
      "An override applies only where its mapped Cardmarket variant exists for the language, unless mappedVariants is empty."
    ]
  },
  "sources": {
    "holofoil-patterns": {
      "url": "https://bulbapedia.bulbagarden.net/wiki/Holographic_card",
      "sourceType": "Bulbapedia holofoil pattern history",
      "evidence": "Documents reverse-holo pattern eras, including EX-era set-logo treatments, Dragon Frontiers foil placement, and later reverse-holo patterns."
    },
    "dragon-frontiers-specimen": {
      "url": "https://exorgames.com/products/snorlax-10-101-delta-species-stamped-ex-dragon-frontiers",
      "sourceType": "Retail listing with identified physical printing",
      "evidence": "Identifies Snorlax 10/101 as the stamped EX Dragon Frontiers reverse-holo printing."
    },
    "rising-rivals-snorlax": {
      "url": "https://bulbapedia.bulbagarden.net/wiki/Snorlax_(Rising_Rivals_33)",
      "sourceType": "Bulbapedia card release history",
      "evidence": "Documents the special English Crosshatch Holofoil Pokemon League Rival Season printing."
    },
    "call-of-legends-snorlax": {
      "url": "https://bulbapedia.bulbagarden.net/wiki/Snorlax_(Call_of_Legends_33)",
      "sourceType": "Bulbapedia card release history",
      "evidence": "Documents the Call of Legends prerelease promo and the specially stamped Staff printing."
    },
    "pokemon-go-set": {
      "url": "https://bulbapedia.bulbagarden.net/wiki/S10b",
      "sourceType": "Bulbapedia expansion release list",
      "evidence": "Lists Snorlax 055 as a Cosmos Holofoil Pokemon GO Tin exclusive."
    },
    "sv-promos": {
      "url": "https://bulbapedia.bulbagarden.net/wiki/SVP_Black_Star_Promos_(TCG)",
      "sourceType": "Bulbapedia promo release list",
      "evidence": "Lists the relevant SV Black Star Promo distributions and stamped printings."
    },
    "sv-etb": {
      "url": "https://bulbapedia.bulbagarden.net/wiki/Scarlet_%26_Violet_Elite_Trainer_Box",
      "sourceType": "Bulbapedia product release history",
      "evidence": "Documents the standard and Pokemon Center-stamped Snorlax SVP 051 Elite Trainer Box promos."
    },
    "cardmarket-stock-image": {
      "url": null,
      "sourceType": "Cardmarket stock image (visual evidence)",
      "evidence": "Finish, marking, or size is visible in the downloaded stock image; this does not use Cardmarket's language filter as evidence."
    },
    "owner-scan-review": {
      "url": null,
      "sourceType": "Owner attestation plus downloaded scan review",
      "evidence": "The repository owner identified the treatment and it was checked against the downloaded product scan."
    }
  },
