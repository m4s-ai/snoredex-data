        {"id": "collector-catalogue-projection", "command": ["scripts/collector_catalogue.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["collector_catalogue.json", "collector_catalogue.schema.json", "collector_migrations.json", "collector_catalogue.fixture.json"]},
