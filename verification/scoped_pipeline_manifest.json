{
  "schema": "snoredex-scoped-pipeline",
  "version": "1.1.0",
  "fullGate": ["python", "scripts/regen.py", "--check"],
  "runContract": {
    "runId": "UTC timestamp plus lane/manifest/commit fingerprint; caller may pin --run-id",
    "report": "verification/cache/scoped-runs/<runId>.json",
    "defaultNetwork": false,
    "defaultBrowser": false,
    "idempotence": "lane steps may rewrite only their declared projections; repeated offline runs must leave non-SQLite tree bytes unchanged",
    "mergeBoundary": "every lane report is partial evidence; L3 fullGate remains required before merge",
    "batchBoundary": "Import all reviewed rows, checkpoint the affected lane once, then run regen.py once at batch delivery; a successful regen.py already includes the full check."
  },
  "lanes": [
    {
      "id": "physical-evidence",
      "title": "Issue manifest / attachment to physical printing",
      "entry": "verification/fetch_attachment.py manifest or already-reviewed specimen",
      "impactClasses": ["physical-observation", "finish-claim"],
      "dependsOn": ["known-card-confirmation"],
      "minimumGate": "L0",
      "projectionGate": "L2",
      "mergeGate": "L3",
      "releaseGate": "L4",
      "steps": [
        {"id": "finishes-projection", "command": ["scripts/finishes.py", "--offline"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["verification/finish_units.json", "verification/FINISH_REVIEW.json", "verification/FINISH_REVIEW.csv", "analysis_finishes.json", "snorlax_cards.json"]},
        {"id": "confirmed-releases-projection", "command": ["scripts/confirmed_releases.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["analysis_confirmed_releases.json", "analysis_confirmed_releases.csv"]},
        {"id": "source-registry-projection", "command": ["scripts/source_registry.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["verification/source_registry.json", "verification/SOURCES.md"]},
        {"id": "source-capabilities-projection", "command": ["scripts/source_capabilities.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["verification/source_capability_graph.json"]},
        {"id": "authoritative-graph-projection", "command": ["scripts/authoritative_graph.py", "--write"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["verification/authoritative_graph.json"]},
        {"id": "artwork-review-projection", "command": ["scripts/artwork_review.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["verification/artwork_review_projection.json", "verification/artwork_derivative_manifest.json", "images/previews/", "images/thumbs/"]},
        {"id": "checklist-projection", "command": ["scripts/checklist.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["analysis_checklist.json"]},
        {"id": "collector-catalogue-projection", "command": ["scripts/collector_catalogue.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": ["collector_catalogue.json", "collector_catalogue.schema.json", "collector_migrations.json", "collector_catalogue.fixture.json"]},
        {"id": "review-integrity-check", "command": ["verification/review_integrity.py"], "gateLevel": "L2", "network": false, "browser": false, "writes": []},
        {"id": "fetch-attachment-check", "command": ["verification/fetch_attachment.py", "--evidence-check"], "gateLevel": "L0", "network": false, "browser": false, "writes": []}
      ],
      "skippedChecks": ["full L3 regen.py gate and cross-artifact audit", "database, tracker, site and export projections", "browser acceptance", "live source retrieval and snapshot acceptance", "publication/history audit and deployment"]
    },
