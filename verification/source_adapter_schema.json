{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snoredex.example/schema/source-adapter-contract-1.0.0.json",
  "title": "Snoredex source-first adapter contract",
  "type": "object",
  "required": ["meta", "rawRecordContract", "adapters", "explicitMappings", "gaps"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema", "schemaVersion", "coverageVersion", "reviewedAt", "policies"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "snoredex-source-adapter-contract"},
        "schemaVersion": {"const": "1.0.0"},
        "coverageVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "reviewedAt": {"type": "string", "format": "date"},
        "policies": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rawRecordContract": {
      "type": "object",
      "required": ["requiredProvenance", "rawFields", "buckets", "terminalStates"],
      "additionalProperties": false,
      "properties": {
        "requiredProvenance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "rawFields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "buckets": {
          "type": "array",
          "minItems": 4,
          "items": {"enum": ["mapped", "new-candidate", "ambiguous/needs-evidence", "positively-excluded"]}
        },
        "terminalStates": {
          "type": "array",
          "minItems": 3,
          "items": {"enum": ["complete", "needs-evidence", "blocked-by-source"]}
        }
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["adapterId", "adapterVersion", "providerId", "surfaceId", "state", "endpointTemplate", "category", "sourceFirst", "slices"],
        "additionalProperties": false,
        "properties": {
          "adapterId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "adapterVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "providerId": {"type": "string"},
          "surfaceId": {"type": "string"},
          "state": {"const": "active"},
          "endpointTemplate": {"type": "string", "pattern": "^https://"},
          "category": {"enum": ["set", "deck", "promo-series", "product", "release-event"]},
          "sourceFirst": {"const": true},
          "slices": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sliceId", "coverageEdgeId", "rawLocale", "locality", "language", "script"],
              "additionalProperties": false,
              "properties": {
                "sliceId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
                "coverageEdgeId": {"type": "string"},
                "rawLocale": {"type": "string"},
                "locality": {"type": "string"},
                "language": {"type": "string"},
                "script": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "explicitMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["providerId", "surfaceId", "rawLocale", "rawProviderId", "targetType", "targetId", "evidence"],
        "additionalProperties": false,
        "properties": {
          "providerId": {"type": "string"},
          "surfaceId": {"type": "string"},
          "rawLocale": {"type": "string"},
          "rawProviderId": {"type": "string"},
          "targetType": {"enum": ["local-set", "set-edition", "release-event"]},
          "targetId": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gapId", "track", "providerId", "surfaceId", "terminalState", "reason", "retryCondition"],
        "additionalProperties": false,
        "properties": {
          "gapId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "track": {"type": "string", "minLength": 1},
          "providerId": {"type": "string"},
          "surfaceId": {"type": ["string", "null"]},
          "terminalState": {"enum": ["needs-evidence", "blocked-by-source"]},
          "reason": {"type": "string", "minLength": 1},
          "retryCondition": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
