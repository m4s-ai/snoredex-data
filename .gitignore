# Raw third-party API dumps — bulky (TCGdex full multi-language card lists, ~13 MB)
# and reproducible with verification/fetch_full.ps1, fetch_tcgdex.ps1, jp_fetch.ps1, asia_fetch.ps1
verification/cache/

# Intermediate upscaled image crops used once to read the xm2a mirror-foil variants
verification/zoom/

# Local receiver / scratch
verification/_evidence_audit.json

# Golden captures from verification/parity.py. Regenerated on demand against whatever the data
# currently is; committing them would create a second copy of the artifacts that goes stale the
# moment a verification pass runs, and a stale contract gets rubber-stamped rather than read.
verification/parity/

# Python bytecode generated by local validation
__pycache__/
*.py[cod]

# Generated Pages artifact (rebuilt by scripts/publish.py)
_site/
