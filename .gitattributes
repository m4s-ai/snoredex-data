* text=auto eol=lf

*.jpg binary
*.jpeg binary
*.png binary
*.webp binary

# Captured source pages used as parser fixtures: keep the bytes exactly as the server sent them,
# so the fixture keeps reproducing the page shape it was captured for.
verification/fixtures/** -text

# Preserve the publisher's exact legalcode bytes, including its intentional final blank line.
LICENSES/CC-BY-NC-SA-4.0.md whitespace=-blank-at-eof
